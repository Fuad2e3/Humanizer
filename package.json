{
  "name": "humanizer",
  "version": "1.0.0",
  "description": "Rewrite AI text so it reads naturally, while keeping its meaning, numbers and names",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build:vendor": "esbuild scripts/sdk-entry.mjs --bundle --format=esm --minify --platform=browser --outfile=public/vendor/anthropic.js",
    "bump": "node scripts/bump-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
