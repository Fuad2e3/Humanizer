{
  "name": "humanizer",
  "version": "1.0.0",
  "description": "Rewrite AI text so it reads naturally, while keeping its meaning, numbers and names",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "bump": "node scripts/bump-version.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:pdf": "node scripts/copy-pdfjs.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
